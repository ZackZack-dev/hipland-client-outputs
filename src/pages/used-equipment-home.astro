---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Used Equipment" description="Browse used professional sound equipment for sale from System Sound. Quality pre-owned speakers, consoles, microphones, and more at competitive prices.">
  <section class="page-header">
    <div class="container">
      <p class="section-label">Used Equipment</p>
      <h1>Quality pre-owned <span style="color:var(--color-accent)">gear</span>.</h1>
      <p>Well-maintained, ex-hire and trade-in professional audio equipment. All gear is tested and serviced before sale.</p>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <p style="text-align:center; margin-bottom:3rem; font-size:1.05rem">
        Our used equipment inventory changes regularly. Contact us for current availability and pricing.
      </p>
      <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr))">
        <div class="card">
          <h4>Speakers & Line Arrays</h4>
          <p style="font-size:0.9rem">Pre-owned Meyer Sound, L-Acoustics, and other professional loudspeaker systems. Serviced and tested.</p>
        </div>
        <div class="card">
          <h4>Mixing Consoles</h4>
          <p style="font-size:0.9rem">Digital and analogue consoles from DiGiCo, Yamaha, Allen & Heath, and more. Ex-hire, fully maintained.</p>
        </div>
        <div class="card">
          <h4>Wireless Systems</h4>
          <p style="font-size:0.9rem">Sennheiser and Shure wireless microphone systems. Professionally maintained and frequency-checked.</p>
        </div>
        <div class="card">
          <h4>Amplifiers & Processing</h4>
          <p style="font-size:0.9rem">Power amplifiers, system processors, and outboard gear from leading manufacturers.</p>
        </div>
        <div class="card">
          <h4>Cables & Infrastructure</h4>
          <p style="font-size:0.9rem">Multicores, looms, power distribution, rigging hardware, and road cases.</p>
        </div>
        <div class="card">
          <h4>Microphones & DIs</h4>
          <p style="font-size:0.9rem">Wired microphones, DI boxes, stands, and accessories from Shure, Sennheiser, AKG, and Neumann.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Looking for something specific?</h2>
      <p>Our used stock changes fast. Tell us what you're after and we'll let you know what's available.</p>
      <a href="/sales-enquiry-request" class="btn btn-primary">Enquire about used gear</a>
    </div>
  </section>
</BaseLayout>
