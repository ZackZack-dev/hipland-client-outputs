---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Case Studies" description="Explore System Sound's work — Book of Mormon, Sunset Boulevard, Rent, In The Heights. Behind-the-scenes from Australia's leading theatre sound engineering company.">
  <section class="page-head">
    <div class="container">
      <div class="section-num">Case Studies</div>
      <h1 class="hero-headline" style="font-size:clamp(3.5rem, 8vw, 8rem)">Our<br /><span style="color:var(--gold)">work</span></h1>
      <p class="body-text body-lg" style="margin-top:2rem">Behind-the-scenes looks at the productions and projects we're proudest of.</p>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="case-study" style="margin-bottom:6rem">
        <div class="case-media">
          <span class="case-media-label">Production / QPAC Brisbane</span>
          <span style="font-family:var(--font-display);font-size:2.5rem;font-weight:900;text-transform:uppercase;color:var(--gold);opacity:0.3">BOM</span>
        </div>
        <div class="case-content">
          <div class="section-num">01</div>
          <h3 class="case-title">Book of<br />Mormon</h3>
          <p class="body-text">Full audio package for the acclaimed Australian production at QPAC Brisbane. Complete Meyer Sound Leopard system, DiGiCo Quantum console, 100+ channels of Sennheiser Digital 6000 wireless. Sound Design by David Greasley.</p>
          <div class="stat-row">
            <div><div class="stat-val">100+</div><div class="stat-lbl">Wireless Channels</div></div>
            <div><div class="stat-val">Meyer</div><div class="stat-lbl">Leopard System</div></div>
            <div><div class="stat-val">DiGiCo</div><div class="stat-lbl">Quantum</div></div>
          </div>
        </div>
      </div>

      <div class="case-study" style="margin-bottom:6rem">
        <div class="case-media">
          <span class="case-media-label">Tour / 5 Cities</span>
          <span style="font-family:var(--font-display);font-size:2.5rem;font-weight:900;text-transform:uppercase;color:var(--gold);opacity:0.3">SB</span>
        </div>
        <div class="case-content">
          <div class="section-num">02</div>
          <h3 class="case-title">Sunset<br />Boulevard</h3>
          <p class="body-text">The lavish Australian production toured Singapore, Beijing, Shenzhen, Wuhan and Taipei. Sound Design by David Greasley — a masterclass in musical theatre sound and the full utilisation of Meyer Sound, Sennheiser and DiGiCo flagship equipment.</p>
          <div class="stat-row">
            <div><div class="stat-val">5</div><div class="stat-lbl">Cities</div></div>
            <div><div class="stat-val">D6000</div><div class="stat-lbl">Sennheiser</div></div>
            <div><div class="stat-val">Meyer</div><div class="stat-lbl">Leopard</div></div>
          </div>
        </div>
      </div>

      <div class="case-study" style="margin-bottom:6rem">
        <div class="case-media">
          <span class="case-media-label">Production / Sydney Opera House</span>
          <span style="font-family:var(--font-display);font-size:2.5rem;font-weight:900;text-transform:uppercase;color:var(--gold);opacity:0.3">RENT</span>
        </div>
        <div class="case-content">
          <div class="section-num">03</div>
          <h3 class="case-title">Rent</h3>
          <p class="body-text">Opera Australia's production at the iconic Sydney Opera House. Original Australian Sound Design by Evan Drill. System Sound supplied full equipment and crew — Chris Pratt (PSE), Owen Arnold (HoD), and team.</p>
        </div>
      </div>

      <div class="case-study">
        <div class="case-media">
          <span class="case-media-label">Production / Comedy Theatre Melbourne</span>
          <span style="font-family:var(--font-display);font-size:2.5rem;font-weight:900;text-transform:uppercase;color:var(--gold);opacity:0.3">ITH</span>
        </div>
        <div class="case-content">
          <div class="section-num">04</div>
          <h3 class="case-title">In The<br />Heights</h3>
          <p class="body-text">Melbourne remount at the Comedy Theatre. Sound Design by David Tonion. Operator Paul Hitchens. System Sound provided equipment, personnel and operators.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section class="cta-block">
    <div class="container">
      <div class="section-num">Next</div>
      <h2 class="display-md">Your production<br />could be here</h2>
      <p class="body-text" style="margin:0 auto 2.5rem">Let's talk about what you're planning. We'd love to be part of it.</p>
      <a href="/sales-enquiry-request" class="btn btn-primary">Start the conversation</a>
    </div>
  </section>
</BaseLayout>
