---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sales Enquiry" description="Tell us about your project. Request a quote for sound equipment hire, system design, venue installation, or production support from System Sound.">
  <section class="page-head">
    <div class="container">
      <div class="section-num">Enquire</div>
      <h1 class="hero-headline" style="font-size:clamp(3.5rem, 8vw, 8rem)">Tell us<br />about your<br /><span style="color:var(--gold)">project</span></h1>
      <p class="body-text body-lg" style="margin-top:2rem; max-width:48ch">Planning a musical, upgrading a venue, or need gear for an event? We're ready to help.</p>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container" style="max-width:640px">
      <form class="form-grid" action="#" method="POST" style="gap:1.5rem">
        <div class="form-field"><label for="name">Name *</label><input type="text" id="name" name="name" required /></div>
        <div class="form-field"><label for="email">Email *</label><input type="email" id="email" name="email" required /></div>
        <div class="form-field"><label for="phone">Phone</label><input type="tel" id="phone" name="phone" /></div>
        <div class="form-field"><label for="company">Company / Organisation</label><input type="text" id="company" name="company" /></div>
        <div class="form-field">
          <label for="type">Enquiry Type *</label>
          <select id="type" name="type" required>
            <option value="">Select...</option>
            <option value="theatre">Commercial Theatre</option>
            <option value="hire">Equipment Hire</option>
            <option value="sales">Meyer Sound Sales</option>
            <option value="schools">Schools & Education</option>
            <option value="install">Venue Installation</option>
            <option value="used">Used Equipment</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form-field"><label for="message">Tell us about your project *</label><textarea id="message" name="message" required placeholder="What do you need? When? Where? The more detail, the better."></textarea></div>
        <button type="submit" class="btn btn-primary" style="width:100%">Submit enquiry</button>
        <p class="mono-label" style="text-align:center">We'll get back to you within 1-2 business days. No obligation — just genuine expertise.</p>
      </form>
    </div>
  </section>
</BaseLayout>
