---
import { SITE } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="logo">System<span class="logo-accent">Sound</span></a>
        <p class="body-text" style="font-size:0.85rem; margin-top:1rem">
          {SITE.address.office}
        </p>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          <li><a href="/commercial-theatre">Commercial Theatre</a></li>
          <li><a href="/equipment">Equipment Hire</a></li>
          <li><a href="/meyer-sound-sales">Meyer Sound</a></li>
          <li><a href="/schools">Schools</a></li>
          <li><a href="/venue-installation">Installation</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/about-us">About</a></li>
          <li><a href="/case-studies">Case Studies</a></li>
          <li><a href="/press-and-news">News</a></li>
          <li><a href="/used-equipment-home">Used Gear</a></li>
          <li><a href="/location-and-contacts">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Connect</h4>
        <ul>
          <li><a href={SITE.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a href={SITE.social.facebook} target="_blank" rel="noopener">Facebook</a></li>
          <li><a href={`mailto:${SITE.email}`}>Email</a></li>
          <li><a href={`tel:${SITE.phone}`}>Call</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} System Sound Pty. Ltd.</span>
      <a href="/privacy-policy">Privacy</a>
    </div>
  </div>
</footer>
