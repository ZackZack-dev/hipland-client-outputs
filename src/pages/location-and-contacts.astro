---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout title="Contact" description={`Contact System Sound. ${SITE.address.office}. Phone ${SITE.phone}. Email ${SITE.email}.`}>
  <section class="page-head">
    <div class="container">
      <div class="section-num">Contact</div>
      <h1 class="hero-headline" style="font-size:clamp(3.5rem, 8vw, 8rem)">Let's<br /><span style="color:var(--gold)">talk</span></h1>
      <p class="body-text body-lg" style="margin-top:2rem; max-width:48ch">Based in Port Melbourne. Serving productions and venues across Australia and the Asia-Pacific.</p>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="contact-layout">
        <div>
          <h3 class="card-title" style="font-size:2rem; margin-bottom:2rem">System Sound<br />Pty. Ltd.</h3>
          <div class="contact-detail">
            <h4>Office</h4>
            <p>5 Westside Avenue<br />Port Melbourne VIC 3207<br />Australia</p>
          </div>
          <div class="contact-detail">
            <h4>Deliveries</h4>
            <p>5 Bayside Avenue<br />Port Melbourne VIC 3207<br />Australia</p>
          </div>
          <div class="contact-detail">
            <h4>Phone</h4>
            <p><a href={`tel:${SITE.phone}`} style="color:var(--gold)">{SITE.phone}</a></p>
          </div>
          <div class="contact-detail">
            <h4>Email</h4>
            <p><a href={`mailto:${SITE.email}`} style="color:var(--gold)">{SITE.email}</a></p>
          </div>
          <div style="margin-top:2rem; display:flex; gap:1rem">
            <a href={SITE.social.instagram} class="btn" target="_blank" rel="noopener">Instagram</a>
            <a href={SITE.social.facebook} class="btn" target="_blank" rel="noopener">Facebook</a>
          </div>
        </div>
        <div>
          <div class="section-num" style="margin-bottom:1.5rem">Send a Message</div>
          <form class="form-grid" action="/sales-enquiry-request" method="get">
            <div class="form-field">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-field">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" />
            </div>
            <div class="form-field">
              <label for="message">What are you working on?</label>
              <textarea id="message" name="message" required placeholder="Tell us about your production, venue, or project..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%">Send enquiry</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
