---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found">
  <section class="page-head" style="min-height:60vh; display:flex; flex-direction:column; align-items:center; justify-content:center">
    <div class="container" style="text-align:center">
      <div class="section-num" style="margin-bottom:1rem">Error</div>
      <div class="hero-headline" style="font-size:clamp(6rem, 15vw, 15rem); color:var(--gold); margin-bottom:0">404</div>
      <p class="body-text body-lg" style="margin:1rem auto 2rem; text-align:center">That page doesn't exist. But plenty of great ones do.</p>
      <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/commercial-theatre" class="btn">Commercial Theatre</a>
        <a href="/equipment" class="btn">Equipment</a>
      </div>
    </div>
  </section>
</BaseLayout>
