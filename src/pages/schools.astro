---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Schools & Education" description="Professional sound system installation and live audio support for schools across Victoria. Theatre-grade audio solutions for school productions and performing arts centres.">
  <section class="page-head">
    <div class="container">
      <div class="section-num">Schools</div>
      <h1 class="hero-headline" style="font-size:clamp(3.5rem, 8vw, 8rem)">Industry<br />sound for<br /><span style="color:var(--gold)">schools</span></h1>
      <p class="body-text body-lg" style="margin-top:2rem">Professional sound system installation and live audio support for schools across Victoria. Theatre-grade audio trusted by Australia's top performing arts venues — brought into your school.</p>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="section-num">01 / Why System Sound</div>
      <div class="grid-2" style="margin-top:2rem">
        <div>
          <div class="stat-val" style="font-size:1.3rem; margin-bottom:0.5rem">Theatre Expertise</div>
          <p class="card-desc">Over 45 years of experience in musical theatre sound design, working on Australia's most iconic productions. We bring that expertise directly into your school hall or performing arts centre.</p>
        </div>
        <div>
          <div class="stat-val" style="font-size:1.3rem; margin-bottom:0.5rem">Learning Pathways</div>
          <p class="card-desc">We work alongside drama teachers, AV coordinators, and music departments to offer student training, work experience, and career mentorship. Several of our student collaborators have gone on to professional sound engineering careers.</p>
        </div>
        <div>
          <div class="stat-val" style="font-size:1.3rem; margin-bottom:0.5rem">Tailored Systems</div>
          <p class="card-desc">From school halls to purpose-built theatres. Meyer Sound systems, Sennheiser wireless kits, full-stage monitoring. Long-term value, ease of use, broadcast-quality performance.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="section-num">02 / Services</div>
      <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr))">
        <div class="card"><span class="card-num">01</span><h4 class="card-title">Speaker Systems</h4><p class="card-desc">Compact point-source to full line arrays. Designed for your specific hall, theatre, or outdoor space.</p></div>
        <div class="card"><span class="card-num">02</span><h4 class="card-title">Wireless Microphones</h4><p class="card-desc">Sennheiser and Shure — handheld, lapel, headset. Pre-tuned, frequency-coordinated, production-ready.</p></div>
        <div class="card"><span class="card-num">03</span><h4 class="card-title">Mixing Consoles</h4><p class="card-desc">DiGiCo, Allen & Heath, Yamaha. Compact desks for assemblies to full theatre control surfaces.</p></div>
        <div class="card"><span class="card-num">04</span><h4 class="card-title">Training & Mentorship</h4><p class="card-desc">Hands-on workshops. Learn from working theatre professionals. Real-world live sound skills.</p></div>
        <div class="card"><span class="card-num">05</span><h4 class="card-title">Installation</h4><p class="card-desc">Permanent systems. Full commissioning, tuning, user training. Ongoing support and maintenance.</p></div>
        <div class="card"><span class="card-num">06</span><h4 class="card-title">Production Support</h4><p class="card-desc">Need crew for your musical? Operators, technicians, support staff for school production seasons.</p></div>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section class="cta-block">
    <div class="container">
      <div class="section-num">03 / Start</div>
      <h2 class="display-md">Upgrade your<br />school's sound</h2>
      <p class="body-text" style="margin:0 auto 2.5rem">Simple mic setup or fully integrated theatre system — let's talk.</p>
      <a href="/sales-enquiry-request" class="btn btn-primary">Get in touch</a>
    </div>
  </section>
</BaseLayout>
