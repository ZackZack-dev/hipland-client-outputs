---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Venue Installation" description="Custom audio system design and installation for theatres, venues, churches, and performance spaces. Expert commissioning, tuning, and ongoing support from System Sound.">
  <section class="page-head">
    <div class="container">
      <div class="section-num">Installation</div>
      <h1 class="hero-headline" style="font-size:clamp(3.5rem, 8vw, 8rem)">Built for<br />the <span style="color:var(--gold)">long<br />run</span></h1>
      <p class="body-text body-lg" style="margin-top:2rem">Custom audio system design, installation, and commissioning for theatres, venues, churches, schools, hospitality, and public spaces.</p>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="section-num">01 / What We Offer</div>
      <div class="grid-2" style="margin-top:2rem">
        <div>
          <p class="body-text">With 45+ years of experience and direct relationships with the world's best equipment manufacturers — including being a direct Meyer Sound distributor — System Sound offers end-to-end venue installation services that deliver premium, long-term audio solutions. We don't just install speakers. We design systems that work for your space, your users, and your budget.</p>
        </div>
        <div>
          <ul class="equip-list">
            <li>Venue assessment and acoustic analysis</li>
            <li>System design and coverage prediction</li>
            <li>Equipment specification and supply — direct pricing</li>
            <li>Professional installation, rigging, cabling</li>
            <li>Commissioning and tuning</li>
            <li>User training and documentation</li>
            <li>Ongoing support and maintenance</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="section-num">02 / Process</div>
      <div class="grid-4" style="margin-top:2rem">
        <div><div class="stat-val" style="font-size:1.5rem; margin-bottom:0.5rem">01 Listen</div><p class="card-desc">We visit your venue, understand your needs, your users, and your ambitions. No assumptions.</p></div>
        <div><div class="stat-val" style="font-size:1.5rem; margin-bottom:0.5rem">02 Design</div><p class="card-desc">Bespoke system design with coverage predictions, equipment schedules, and transparent pricing.</p></div>
        <div><div class="stat-val" style="font-size:1.5rem; margin-bottom:0.5rem">03 Install</div><p class="card-desc">Professional installation by experienced theatre technicians. Clean, safe, compliant.</p></div>
        <div><div class="stat-val" style="font-size:1.5rem; margin-bottom:0.5rem">04 Support</div><p class="card-desc">Training, documentation, ongoing support. We're here for the life of the system.</p></div>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="section-num">03 / Venues</div>
      <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(240px, 1fr))">
        <div class="card"><h4 class="card-title">Theatres</h4><p class="card-desc">Professional theatres and performing arts centres</p></div>
        <div class="card"><h4 class="card-title">Schools</h4><p class="card-desc">Halls, theatres, and music departments</p></div>
        <div class="card"><h4 class="card-title">Churches</h4><p class="card-desc">Houses of worship and community spaces</p></div>
        <div class="card"><h4 class="card-title">Hospitality</h4><p class="card-desc">Restaurants, bars, nightclubs</p></div>
        <div class="card"><h4 class="card-title">Corporate</h4><p class="card-desc">Conference spaces and boardrooms</p></div>
        <div class="card"><h4 class="card-title">Public Spaces</h4><p class="card-desc">Council venues, outdoor areas, community halls</p></div>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section class="cta-block">
    <div class="container">
      <div class="section-num">04 / Start</div>
      <h2 class="display-md">Thinking about<br />a venue upgrade?</h2>
      <p class="body-text" style="margin:0 auto 2.5rem">Let's visit your space and talk about what's possible. No obligation, genuine advice.</p>
      <a href="/sales-enquiry-request" class="btn btn-primary">Arrange a consultation</a>
    </div>
  </section>
</BaseLayout>
