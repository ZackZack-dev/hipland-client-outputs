---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRODUCTIONS } from '../data/site';
---

<BaseLayout title="About Us" description="System Sound — one of Australia's most recognisable sound companies. Founded 1979 by John Scandrett. 45+ years of technical excellence in theatre audio.">
  <section class="page-head">
    <div class="container">
      <div class="section-num">About</div>
      <h1 class="hero-headline" style="font-size:clamp(3.5rem, 8vw, 8rem)">Sound<br />engineering<br />since <span style="color:var(--gold)">1979</span></h1>
      <p class="body-text body-lg" style="margin-top:2rem">One of Australia's most recognisable and historic sound companies. Built on technical excellence, commitment to quality, and genuine care for every production.</p>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="section-num">01 / Story</div>
      <div class="grid-2">
        <div>
          <p class="body-text">System Sound was founded in 1979 by owner and managing director John Scandrett. The company was built on technical excellence, commitment to quality and technical innovation. Our history spans back to the prolific JC Williamson Theatre Company, where John Scandrett worked as one of Australia's first theatre sound designers.</p>
        </div>
        <div>
          <p class="body-text">As a recently graduated physicist with a passion for electronics and as a violinist in a chamber orchestra, John was uniquely skilled to meet the requirements of theatrical sound reinforcement. Over the years, the team he built set System Sound to become the go-to name for high quality theatrical products and all events requiring world class sound engineering.</p>
        </div>
      </div>
      <div class="rule" style="margin-top:3rem"></div>
      <p class="body-text body-lg" style="margin-top:3rem; max-width:60ch">
        By the 2000s, we had designed and provided sound for hundreds of productions and events, some of which — like The Phantom of the Opera and the Hong Kong Handover of 1997 — defined an era of exponential expansion in technical innovation and the development of live entertainment itself.
      </p>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="section-num">02 / Approach</div>
      <h2 class="section-headline">How<br />we work</h2>
      <div class="grid-2" style="margin-top:2.5rem">
        <div>
          <p class="body-text">Our uncompromising approach to service is what sets us apart. Meticulous planning and seamless execution minimise downtime, enabling fast, well-ordered turnarounds on every job, big or small. We understand the daily realities of theatre and the demands of long-term performance.</p>
        </div>
        <div>
          <p class="body-text">We empower local designers and production teams with best-in-class tools and technology — including Meyer Sound loudspeakers and control systems — to approach any project with the same enthusiasm and deliver a top-tier, seamless result. From school musicals to the biggest theatre productions in the world — we service them all with equal energy.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="section-num">03 / Credits</div>
      <h2 class="section-headline" style="font-size:clamp(2rem, 4vw, 4rem)">Productions<br />we've been<br />part of</h2>
      <div class="card-grid" style="margin-top:2.5rem">
        {PRODUCTIONS.map((p, i) => (
          <div class="card">
            <span class="card-num">{(i + 1).toString().padStart(2, '0')}</span>
            <h4 class="card-title" style="font-size:1.1rem">{p}</h4>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="section-num">04 / Orchestral & Symphonic</div>
      <div class="grid-2">
        <div>
          <p class="body-text">System Sound specialises in orchestral sound reinforcement and works with the Hong Kong Philharmonic, KBS Orchestra (Seoul), The Singapore Symphony, Orchestra Victoria, the Australian Pops Orchestra, The Sydney Opera House, The Arts Centre Melbourne.</p>
        </div>
        <div>
          <p class="body-text">Large scale projects include the Hong Kong and Macau Handovers, Melbourne's Millennium New Year's Eve Celebrations, and stadium concerts with Dame Kiri Te Kanawa, José Carreras, Plácido Domingo, Andrea Bocelli, and Luciano Pavarotti.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section class="cta-block">
    <div class="container">
      <div class="section-num">05 / Connect</div>
      <h2 class="display-md">Work<br />with us</h2>
      <p class="body-text" style="margin:0 auto 2.5rem">Talk to us about your next production. We'd love to hear what you're working on.</p>
      <a href="/sales-enquiry-request" class="btn btn-primary">Get in touch</a>
    </div>
  </section>
</BaseLayout>
