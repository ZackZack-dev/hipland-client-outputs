---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="News & Press" description="Latest news, press coverage, and updates from System Sound. Industry articles, production news, and behind-the-scenes from Australia's leading theatre sound company.">
  <section class="page-header">
    <div class="container">
      <p class="section-label">News & Press</p>
      <h1>What's <span style="color:var(--color-accent)">happening</span>.</h1>
      <p>Industry coverage, production updates, and behind-the-scenes from the System Sound team.</p>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <div class="news-grid">
        <article class="news-card">
          <div class="news-card-body">
            <div class="news-card-date">October 2025</div>
            <h3>Converting with The Book of Mormon</h3>
            <p>Associate Sound Designer David Greasley speaks with CX Network about System Sound's switch from L'Acoustics to Meyer Sound for Book of Mormon.</p>
            <a href="https://www.cxnetwork.com.au/converting-with-the-book-of-mormon/" class="card-link" target="_blank" rel="noopener">Read on CX Network →</a>
          </div>
        </article>

        <article class="news-card">
          <div class="news-card-body">
            <div class="news-card-date">August 2025</div>
            <h3>Audio Technology Magazine — Sound for Sunset Boulevard</h3>
            <p>An in-depth feature on the sound design for Sunset Boulevard's Australian premiere, with Meyer Sound Leopard and 900-LFC systems.</p>
            <a href="https://www.audiotechnology.com/features/sound-for-sunset-boulevard" class="card-link" target="_blank" rel="noopener">Read on Audio Technology →</a>
          </div>
        </article>

        <article class="news-card">
          <div class="news-card-body">
            <div class="news-card-date">August 2025</div>
            <h3>CX Magazine — Moulin Rouge: More Is More</h3>
            <p>Jason Allen explores the sound behind the world's biggest musical, featuring System Sound's work on the Australian production.</p>
            <a href="https://www.cxnetwork.com.au/moulin-rouge-more-is-more/" class="card-link" target="_blank" rel="noopener">Read on CX Network →</a>
          </div>
        </article>

        <article class="news-card">
          <div class="news-card-body">
            <div class="news-card-date">2025</div>
            <h3>Rent at Sydney Opera House</h3>
            <p>A tremendous opening night at the Sydney Opera House for Opera Australia's Rent. System Sound supplied equipment and crew for this exciting new production, with original Australian Sound Design by Evan Drill.</p>
          </div>
        </article>

        <article class="news-card">
          <div class="news-card-body">
            <div class="news-card-date">2025</div>
            <h3>Sunset Boulevard Asia Tour</h3>
            <p>The Australian production toured through Singapore, Beijing, Shenzhen, Wuhan, and Taipei. Sound Design by David Greasley — a masterclass in musical theatre sound.</p>
          </div>
        </article>

        <article class="news-card">
          <div class="news-card-body">
            <div class="news-card-date">2025</div>
            <h3>In The Heights — Melbourne</h3>
            <p>Proudly providing sound equipment, personnel and operators for the exciting Melbourne remount sound designed by David Tonion at the Comedy Theatre.</p>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
