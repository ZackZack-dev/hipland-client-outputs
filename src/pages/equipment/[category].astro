---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EQUIPMENT_CATEGORIES } from '../../data/site';

export function getStaticPaths() {
  return EQUIPMENT_CATEGORIES.map(cat => ({
    params: { category: cat.slug },
    props: { category: cat }
  }));
}

const { category } = Astro.props;

const equipmentByCategory = {
  'speakers': { description: 'Professional loudspeaker systems from Meyer Sound, L-Acoustics and more. Line arrays, point source, subwoofers, and stage monitors available for hire and sale.', items: ['Meyer Sound Leopard line array', 'Meyer Sound PANTHER line array', 'Meyer Sound LFC2100 subwoofer', 'Meyer Sound UP-4slim', 'Meyer Sound UPA series', 'L-Acoustics KIVA', 'L-Acoustics SB18 sub', 'Stage monitors', 'Front-fill speakers', 'Delay speakers'] },
  'mixing-consoles': { description: 'Digital and analogue mixing consoles from DiGiCo, Allen & Heath, Yamaha, and more for theatre, live sound, and broadcast applications.', items: ['DiGiCo Quantum series', 'DiGiCo SD series', 'Allen & Heath dLive', 'Yamaha CL/QL series', 'Yamaha PM series', 'Analogue consoles'] },
  'radio-microphones': { description: 'Sennheiser and Shure wireless microphone systems. Handheld, bodypack, headset, and lavalier. Professionally maintained and frequency coordinated.', items: ['Sennheiser Digital 6000 series', 'Sennheiser Digital 9000 series', 'Sennheiser evolution wireless G4', 'Shure Axient Digital', 'Shure UHF-R', 'Handheld transmitters', 'Bodypack transmitters', 'Headset microphones', 'Lavalier microphones'] },
  'microphones': { description: 'Wired microphones for stage, studio, and broadcast. Dynamic, condenser, and ribbon mics from Shure, Sennheiser, AKG, Neumann, and more.', items: ['Shure SM58 / SM57', 'Sennheiser MD421 / e604', 'AKG C414', 'Neumann KM184', 'DPA microphones', 'DI boxes', 'Microphone stands'] },
  'amplifiers': { description: 'Power amplifiers for professional audio systems. Reliable, tour-grade amplification for any production scale.', items: ['Meyer Sound Galileo GALAXY', 'Lab.gruppen PLM series', 'Powersoft K series', 'Crown I-Tech', 'QSC PLX series'] },
  'signal-processing': { description: 'System processors, equalisers, dynamics processors, and effects units for system optimisation and creative sound design.', items: ['Meyer Sound Galileo GALAXY', 'System EQ', 'Compressors / limiters', 'Effects processors', 'Digital signal processors'] },
  'comms-two-ways': { description: 'Intercom and two-way radio systems for production communication. Clear, reliable comms for every department.', items: ['Clear-Com intercom systems', 'Two-way radios', 'Wired and wireless beltpacks', 'Headsets', 'Base stations'] },
  'outboard-processors': { description: 'Professional outboard processing for studio and live applications. Dynamics, EQ, effects, and more.', items: ['Compressors', 'Gates', 'Equalisers', 'Reverb units', 'Multi-effects processors'] },
  'cables': { description: 'Professional audio cabling for all applications. XLR, NL4, multicore, fibre, and custom looms.', items: ['XLR microphone cables', 'NL4/NL8 speaker cables', 'Multicore systems', 'Fibre optic cables', 'Network cables', 'Custom looms', 'Power distribution'] },
  'backline': { description: 'Backline equipment for live performances. Amplifiers, keyboards, drums, and instruments.', items: ['Guitar amplifiers', 'Bass amplifiers', 'Keyboard amplifiers', 'Drum kits', 'DI boxes', 'Instrument cables'] },
  'computer-systems-and-recording': { description: 'Computer systems and recording interfaces for live recording, playback, and show control.', items: ['Audio interfaces', 'Recording systems', 'Playback systems', 'Show control computers', 'Dante / network audio interfaces'] },
  'sound-baffling': { description: 'Acoustic treatment and sound baffling solutions for venue optimisation and noise control.', items: ['Acoustic panels', 'Sound curtains', 'Baffles', 'Portable acoustic treatment', 'Custom solutions'] },
};

const data = equipmentByCategory[category.slug] || { description: `Professional ${category.name.toLowerCase()} for hire and sale from System Sound.`, items: [] };
---

<BaseLayout title={`${category.name} Hire & Sales`} description={data.description}>
  <section class="page-header">
    <div class="container">
      <p class="section-label">Equipment</p>
      <h1>{category.name}</h1>
      <p>{data.description}</p>
    </div>
  </section>

  <section class="content-section">
    <div class="container" style="max-width:780px">
      <div class="prose">
        <h2>Available Equipment</h2>
        {data.items.length > 0 ? (
          <ul>
            {data.items.map(item => <li>{item}</li>)}
          </ul>
        ) : (
          <p>Contact us for current availability and specific requirements in this category.</p>
        )}
        <p style="margin-top:2rem">All equipment is professionally maintained, tested, and prepared for each hire. For pricing, availability, or to discuss your specific requirements, please get in touch.</p>
      </div>
      <div style="text-align:center; margin-top:2rem">
        <a href="/equipment" class="btn btn-outline btn-sm">← Back to all equipment</a>
        <a href="/sales-enquiry-request" class="btn btn-primary btn-sm" style="margin-left:1rem">Enquire about {category.name.toLowerCase()}</a>
      </div>
    </div>
  </section>
</BaseLayout>
