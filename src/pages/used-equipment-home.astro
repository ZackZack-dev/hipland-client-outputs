---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Used Equipment" description="Quality pre-owned professional sound equipment for sale from System Sound. Well-maintained ex-hire and trade-in gear. Serviced and tested.">
  <section class="page-head">
    <div class="container">
      <div class="section-num">Used Equipment</div>
      <h1 class="hero-headline" style="font-size:clamp(3.5rem, 8vw, 8rem)">Quality<br />pre-owned<br /><span style="color:var(--gold)">gear</span></h1>
      <p class="body-text body-lg" style="margin-top:2rem">Well-maintained, ex-hire and trade-in professional audio equipment. All gear tested and serviced before sale.</p>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section">
    <div class="container">
      <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr))">
        <div class="card"><span class="card-num">01</span><h4 class="card-title">Speakers & Line Arrays</h4><p class="card-desc">Pre-owned Meyer Sound, L-Acoustics, and other professional loudspeaker systems.</p></div>
        <div class="card"><span class="card-num">02</span><h4 class="card-title">Mixing Consoles</h4><p class="card-desc">Digital and analogue consoles from DiGiCo, Yamaha, Allen & Heath. Ex-hire, fully maintained.</p></div>
        <div class="card"><span class="card-num">03</span><h4 class="card-title">Wireless Systems</h4><p class="card-desc">Sennheiser and Shure wireless microphone systems. Professionally maintained and frequency-checked.</p></div>
        <div class="card"><span class="card-num">04</span><h4 class="card-title">Amplifiers & Processing</h4><p class="card-desc">Power amplifiers, system processors, and outboard gear from leading manufacturers.</p></div>
        <div class="card"><span class="card-num">05</span><h4 class="card-title">Cables & Infrastructure</h4><p class="card-desc">Multicores, looms, power distribution, rigging hardware, and road cases.</p></div>
        <div class="card"><span class="card-num">06</span><h4 class="card-title">Microphones & DIs</h4><p class="card-desc">Wired microphones, DI boxes, stands, and accessories from Shure, Sennheiser, AKG, Neumann.</p></div>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section class="cta-block">
    <div class="container">
      <h2 class="display-md">Looking for<br />something specific?</h2>
      <p class="body-text" style="margin:0 auto 2.5rem">Our used stock changes fast. Tell us what you're after.</p>
      <a href="/sales-enquiry-request" class="btn btn-primary">Enquire about used gear</a>
    </div>
  </section>
</BaseLayout>
