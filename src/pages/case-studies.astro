---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Case Studies" description="Explore System Sound's work on major theatre productions, venue installations, and events. Case studies from Australia's leading sound engineering company.">
  <section class="page-header">
    <div class="container">
      <p class="section-label">Case Studies</p>
      <h1>Our <span style="color:var(--color-accent)">work</span>.</h1>
      <p>Behind-the-scenes looks at some of the productions and projects we're proudest of.</p>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <div class="case-study" style="margin-bottom:4rem">
        <div class="case-study-image">🎭 Book of Mormon at QPAC Brisbane</div>
        <div class="case-study-content">
          <h3>Book of Mormon — Brisbane 2026</h3>
          <p>Full audio package for the acclaimed Australian production. Complete Meyer Sound Leopard system, DiGiCo Quantum console, and over 100 channels of Sennheiser wireless. Sound Design by David Greasley.</p>
          <div class="stat-grid">
            <div class="stat-item"><div class="stat-number">100+</div><div class="stat-label">Wireless Channels</div></div>
            <div class="stat-item"><div class="stat-number">Meyer</div><div class="stat-label">Leopard System</div></div>
            <div class="stat-item"><div class="stat-number">DiGiCo</div><div class="stat-label">Quantum</div></div>
          </div>
        </div>
      </div>

      <div class="case-study" style="margin-bottom:4rem">
        <div class="case-study-image">🌅 Sunset Boulevard Asia Tour</div>
        <div class="case-study-content">
          <h3>Sunset Boulevard — Asia Tour 2025</h3>
          <p>The lavish Australian production toured Singapore, Beijing, Shenzhen, Wuhan and Taipei. Sound Design by David Greasley — a masterclass in musical theatre sound and the full utilisation of Meyer Sound, Sennheiser and DiGiCo flagship equipment.</p>
          <div class="stat-grid">
            <div class="stat-item"><div class="stat-number">5</div><div class="stat-label">Cities</div></div>
            <div class="stat-item"><div class="stat-number">D6000</div><div class="stat-label">Sennheiser</div></div>
            <div class="stat-item"><div class="stat-number">Meyer</div><div class="stat-label">Leopard</div></div>
          </div>
        </div>
      </div>

      <div class="case-study" style="margin-bottom:4rem">
        <div class="case-study-image">🏠 Sydney Opera House</div>
        <div class="case-study-content">
          <h3>Rent — Sydney Opera House 2025</h3>
          <p>Opera Australia's production of Rent at the iconic Sydney Opera House. Original Australian Sound Design by Evan Drill. System Sound supplied full equipment and crew including Chris Pratt (PSE), Owen Arnold (HoD), and team.</p>
        </div>
      </div>

      <div class="case-study">
        <div class="case-study-image">🏙️ In The Heights — Melbourne</div>
        <div class="case-study-content">
          <h3>In The Heights — Melbourne 2025</h3>
          <p>Melbourne remount at the Comedy Theatre. Sound Design by David Tonion, operated by Paul Hitchens. System Sound provided equipment, personnel and operators.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Your production could be next.</h2>
      <p>Let's talk about what you're planning. We'd love to be part of it.</p>
      <a href="/sales-enquiry-request" class="btn btn-primary">Start the conversation</a>
    </div>
  </section>
</BaseLayout>
