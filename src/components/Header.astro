---
import { NAV } from '../data/site';
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      System<span class="logo-accent">Sound</span>
    </a>
    <button class="mobile-toggle" id="mobileToggle" aria-label="Menu">+</button>
    <nav>
      <ul class="nav-list" id="navList">
        {NAV.map(item => (
          <li class={item.href === '/sales-enquiry-request' ? 'nav-cta' : ''}>
            <a
              href={item.href}
              class={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'active' : ''}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  document.getElementById('mobileToggle')?.addEventListener('click', () => {
    document.getElementById('navList')?.classList.toggle('open');
  });
</script>
